# Copiá este archivo como ".env" y completá los valores. NUNCA subas el .env a internet ni a GitHub.

# Puerto donde escucha el servidor (los servicios de hosting suelen definirlo solos).
PORT=3000

# Contraseña del panel /admin (mínimo 10 caracteres). Sin esto, el panel queda deshabilitado.
ADMIN_PASSWORD=

# Clave para firmar la sesión del administrador (mínimo 24 caracteres al azar).
# Podés generarla con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Ubicación de la base de datos SQLite (en hosting, usar un disco persistente, ej. /data/campo.db).
DB_PATH=data/campo.db

# Correo de contacto que se envía en el User-Agent a las fuentes (buena práctica con servicios públicos).
CONTACT_EMAIL=

# Open-Meteo: dejar VACÍO si la app es gratuita y sin publicidad (uso no comercial).
# Si la app tiene publicidad o cobra suscripción, contratar un plan en https://open-meteo.com/en/pricing y pegar la clave acá.
OPEN_METEO_API_KEY=

# Actualización automática (dejar en true).
SCHEDULER_ENABLED=true
